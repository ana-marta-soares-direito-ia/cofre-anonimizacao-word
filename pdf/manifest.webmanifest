{
  "name": "Cofre PDF",
  "short_name": "Cofre PDF",
  "description": "Anonimização local de documentos PDF. Ana Marta Soares, Especialista em IA aplicada ao Direito.",
  "id": "/cofre-anonimizacao-word/pdf/",
  "start_url": "/cofre-anonimizacao-word/pdf/",
  "scope": "/cofre-anonimizacao-word/",
  "display": "standalone",
  "background_color": "#f4f1ec",
  "theme_color": "#1e1a18",
  "lang": "pt-PT",
  "icons": [
    { "src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "/cofre-anonimizacao-word/pdf/", "accept": { "application/pdf": [".pdf"] }, "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": "navigate-new" }
}
