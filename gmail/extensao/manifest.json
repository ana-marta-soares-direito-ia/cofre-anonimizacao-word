{
  "manifest_version": 3,
  "name": "Cofre para Gmail",
  "version": "1.0.0",
  "description": "Assistente de correio electrónico com protecção de dados pessoais. Ana Marta Soares, Especialista em IA aplicada ao Direito.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Cofre para Gmail", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://concurso-antes-ana-marta-soares.pages.dev/*",
    "https://ana-marta-soares-direito-ia.github.io/*"
  ],
  "content_scripts": [{ "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
